# Two-stage pre-commit: fast hooks on every commit, slow ones before a push.
# These hooks work for any stack. Add the project's own formatters, linters and fast tests under `repo: local`,
# and its slow suites with `stages: [pre-push]`.

default_stages: [pre-commit]
default_install_hook_types: [pre-commit, pre-push]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
        args: ["--maxkb=500"]
      - id: check-merge-conflict

  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
